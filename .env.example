# ── LLM Provider API Keys ──────────────────────────────────────────
# 설정하고자 하는 LLM 제공자(Provider)의 API 키를 지정하세요.
# (우선순위: OpenAI > Anthropic > Google / 키가 모두 비어 있으면 Fallback Mock LLM 작동)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# ── MCP Server Configuration (Agent Discovery) ─────────────────────
MCP_SERVER_URL=http://agent_mcp_server:28002
