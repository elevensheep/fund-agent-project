# ── LLM Provider API Keys ──────────────────────────────────────────
# 설정하고자 하는 LLM 제공자(Provider)의 API 키를 지정하세요.
# (우선순위: OpenAI > Anthropic > Google / 키가 모두 비어 있으면 Fallback Mock LLM 작동)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# ── MCP Server Configuration (Agent Discovery) ─────────────────────
MCP_SERVER_URL=http://agent_mcp_server:28002

# ── PostgreSQL Database Settings ───────────────────────────────────
POSTGRES_HOST=agent_postgres
POSTGRES_PORT=5432
POSTGRES_DB=agent_stock_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pw
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Korea Investment & Securities (KIS) WebSocket & REST API ───────
KIS_APP_KEY=your_kis_app_key_here
KIS_APP_SECRET=your_kis_app_secret_here
KIS_ACCOUNT_NO=your_account_no_here
KIS_IS_PAPER_TRADING=false
KIS_WS_URL=ws://ops.koreainvestment.com:21000/tryitout/H0STCNT0
KIS_REST_URL=https://openapi.koreainvestment.com:9443
